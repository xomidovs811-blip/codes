# Telegram bot token from @BotFather
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Public HTTPS base URL where the mini app (webapp/) is served.
# This MUST be a real https:// URL for Telegram to allow opening it as a Mini App.
# Example after deploying to Railway/Render: https://your-app.up.railway.app
WEBAPP_URL=https://example.com

# Database. Defaults to local SQLite file if not set.
# For Postgres on Railway/Render, set e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./zayavka.db

# "Кому" stays fixed, shown read-only in the wizard/Excel (per spec)
FIXED_KOMU=Далеров А.Д

# Short names of the 2 Mini Apps you register with @BotFather (/newapp) for
# Zayavkalar jadvali / Zayavkani qidirish. Zayavka berish is now the bot's
# chat wizard, not a Mini App page, so it doesn't need one.
MINIAPP_JADVAL=jadval
MINIAPP_QIDIRISH=qidirish

# Optional: only respond to /start and /zayavka inside these group(s).
# Comma-separated chat ids. Leave empty to allow the bot in any group.
ALLOWED_GROUP_IDS=

# The broadcast channel to post the "open the bot" button into (see README:
# "Using it inside a Telegram channel"). Leave empty if you don't use one.
CHANNEL_ID=

# Telegram user ids allowed to run /post_channel_menu. Leave empty to allow
# any user who can message the bot privately to run it (fine for a small
# team; set this once you add more people to be safe).
ADMIN_IDS=

# Per-person routing: when "От кого" on a submitted zayavka equals one of
# these names, the finished file goes ONLY to that person's own chat id
# instead of the normal ALLOWED_GROUP_IDS/CHANNEL_ID.
# Format: "Name1:chatid1,Name2:chatid2"
PERSON_ROUTES=
